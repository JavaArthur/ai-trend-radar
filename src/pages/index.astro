---
import Layout from "../layouts/Layout.astro";
import raw from "../../data/catalog.json";
import type { Catalog } from "../lib/types";
import {
  family,
  sections,
  directoryCategories,
  featuredNames,
} from "../lib/directory";
import { metrics } from "../lib/metrics";
import { compact, datetime } from "../lib/display";
const catalog = raw as Catalog;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const weekly = new Map(
  catalog.trending.weekly.entries.map((e) => [e.fullName.toLowerCase(), e]),
);
const projects = catalog.projects
  .filter((p) => family(p))
  .sort(
    (a, b) =>
      (weekly.get(a.fullName.toLowerCase())?.rank || 999) -
        (weekly.get(b.fullName.toLowerCase())?.rank || 999) ||
      b.stars - a.stars,
  );
const features = featuredNames
  .map((n) => projects.find((p) => p.fullName === n))
  .filter(Boolean);
const skills = projects.filter((p) => family(p) === "skills").length;
---

<Layout>
  <main id="main">
    <section class="hero shell">
      <div class="hero-copy">
        <p class="hero-kicker">
          <span class="live-dot"></span> 给创作者的 AI 开源工具馆
        </p>
        <h1>
          好想法，
          <br />
          配上<span>好工具。</span>
        </h1>
        <p class="hero-intro">
          发现值得一试的 Skills 和开源应用。
          <br />
          从做一张图、写一段代码，到完成一支视频。
        </p>
        <a class="hero-cta" href="#explore">
          找一个趁手的工具 <span>↘</span>
        </a>
        <div class="hero-foot">
          <span>
            <strong>{skills}</strong> 个 Skills
          </span>
          <span>
            <strong>{projects.length - skills}</strong> 个应用工具
          </span>
          <a href={`${base}/about/`}>每天追踪 GitHub 热度 ↗</a>
        </div>
      </div>
      <div class="spotlight">
        <div class="spotlight-heading">
          <span>从一支视频开始</span>
          <span>编辑推荐 · 视频 Skills</span>
        </div>
        <div class="feature-stack">
          {features.map(
            (p, i) =>
              p && (
                <a
                  class={`feature feature-${i}`}
                  href={`${base}/projects/${p.slug}/`}
                >
                  <div class="feature-art" aria-hidden="true">
                    {i === 0 ? (
                      <>
                        <span class="remotion-orbit"></span>
                        <b>R</b>
                      </>
                    ) : i === 1 ? (
                      <>
                        <span class="shot-frame"></span>
                        <b>▶</b>
                      </>
                    ) : (
                      <>
                        <i></i>
                        <i></i>
                        <i></i>
                      </>
                    )}
                  </div>
                  <div class="feature-copy">
                    <span>
                      {i === 0
                        ? "React → 视频"
                        : i === 1
                          ? "素材 → 产品演示片"
                          : "HTML → 动态影像"}
                    </span>
                    <h2>
                      {i === 0
                        ? "Remotion Skills"
                        : i === 1
                          ? "Video Shotcraft"
                          : "Hyperframes"}
                    </h2>
                    <p>
                      {i === 0
                        ? "把编程助手变成视频搭档"
                        : i === 1
                          ? "镜头、配音、节奏，一次编排"
                          : "用网页技术，写出你的下一支视频"}
                    </p>
                  </div>
                  <span class="feature-arrow">↗</span>
                </a>
              ),
          )}
        </div>
        <p class="spotlight-note">
          灵感入口，非热度排名。项目的真实增长记录可在详情查看。
        </p>
      </div>
    </section>
    <section id="explore" class="directory shell">
      <div class="directory-top">
        <div>
          <p class="section-caption">工具就在这里</p>
          <h2>下一件作品，从这里开始。</h2>
        </div>
        <label class="search-box">
          <span aria-hidden="true">⌕</span>
          <input
            id="search"
            type="search"
            placeholder="搜索工具、用途、关键词…"
            aria-label="搜索工具、用途、关键词"
          />
          <kbd>/</kbd>
        </label>
      </div>
      <div class="family-row" role="group" aria-label="项目类型">
        <button
          class="family-tab active"
          data-family="skills"
          aria-pressed="true"
        >
          Skills <span>{skills}</span>
        </button>
        <button class="family-tab" data-family="tools" aria-pressed="false">
          开源应用工具 <span>{projects.length - skills}</span>
        </button>
        <button id="favorites" class="favorite-filter" aria-pressed="false">
          ☆ 我的收藏 <span id="favorite-count">0</span>
        </button>
      </div>
      <div class="category-row" role="group" aria-label="用途筛选">
        <button
          class="category-chip active"
          data-category="all"
          aria-pressed="true"
        >
          全部
        </button>
        {sections.map((s) => (
          <button
            class="category-chip"
            data-category={s.id}
            aria-pressed="false"
          >
            <span>{s.icon}</span> {s.name}
          </button>
        ))}
      </div>
      <div class="results-toolbar">
        <p>
          <strong id="result-count">{skills}</strong> 个
          <span id="family-label"> Skills</span>
          <span class="toolbar-divider">/</span>
          <span id="filter-caption">按近期周榜优先展示</span>
        </p>
        <label>
          排序{" "}
          <select id="view" aria-label="榜单与排序">
            <option value="all">全部 · 周榜优先</option>
            <option value="weekly">官方周榜 · AI 精选</option>
            <option value="growth">近 7 天净增</option>
            <option value="rising">持续上升</option>
            <option value="new">最近发现</option>
            <option value="stars">总 Star</option>
          </select>
        </label>
      </div>
      <div id="data-warning" class="notice" hidden></div>
      <p id="view-note" class="view-note">
        推荐与排名各有依据，历史不足的项目显示“观察中”。
      </p>
      <div id="project-grid" class="project-grid">
        {projects.map((p) => {
          const m = metrics(p);
          const cat = directoryCategories(p);
          const w = weekly.get(p.fullName.toLowerCase());
          return (
            <article
              class="project-card"
              hidden={family(p) !== "skills"}
              data-id={p.id}
              data-family={family(p)}
              data-categories={cat.join(" ")}
              data-search={[
                p.fullName,
                p.description,
                p.classification.summary,
                ...p.classification.tags,
                ...cat.map((c) => sections.find((s) => s.id === c)?.name),
              ]
                .join(" ")
                .toLowerCase()}
              data-weekly={w?.rank || 0}
              data-hot={m.hot}
              data-rising={m.rising}
              data-delta={m.delta ?? ""}
              data-new={p.firstSeenAt}
              data-stars={p.stars}
            >
              <a
                class="card-link"
                href={`${base}/projects/${p.slug}/`}
                aria-label={`查看 ${p.fullName} 详情`}
              >
                <div class="card-top">
                  <span class={`project-symbol symbol-${cat[0]}`}>
                    {sections.find((s) => s.id === cat[0])?.icon || "◇"}
                  </span>
                  <span class="project-owner">{p.fullName.split("/")[0]}</span>
                </div>
                <h3>{p.fullName.split("/")[1]}</h3>
                <p class="card-description">
                  {p.classification.summary ||
                    p.description ||
                    "查看项目 README，了解它能做什么。"}
                </p>
                <div class="card-tags">
                  {cat.slice(0, 2).map((c) => (
                    <span>
                      {sections.find((s) => s.id === c)?.name}
                      {family(p) === "skills" ? " Skill" : ""}
                    </span>
                  ))}
                  {p.classification.status === "rules" && (
                    <span class="pending-label">原文简介</span>
                  )}
                </div>
                <div class="card-bottom">
                  <span class="star-count">☆ {compact(p.stars)}</span>
                  <span
                    class:list={["growth-label", { "is-hot": m.hot || !!w }]}
                  >
                    {p.archived
                      ? "已归档"
                      : p.unavailable
                        ? "暂不可用"
                        : w
                          ? `周榜 #${w.rank}`
                          : m.delta !== null
                            ? `7 天 ${m.delta >= 0 ? "+" : ""}${compact(m.delta)}`
                            : "趋势观察中"}
                  </span>
                  <span class="card-arrow" aria-hidden="true">
                    ↗
                  </span>
                </div>
              </a>
              <button
                class="save-button card-save"
                data-save={p.id}
                aria-label={`收藏 ${p.fullName}`}
                aria-pressed="false"
              >
                ☆
              </button>
            </article>
          );
        })}
      </div>
      <div id="empty-state" class="empty-state" hidden>
        <span>⌕</span>
        <h3>这里还没有匹配的工具</h3>
        <p id="empty-note">换个关键词，或看看另一类工具。</p>
        <button id="reset-filters" class="button dark">
          重置筛选
        </button>
      </div>
      <div class="directory-bottom">
        <p>持续收录，也持续观察。收藏只保存在当前浏览器。</p>
        <p>
          数据更新：{datetime(catalog.lastSuccessfulCollectionAt)}（北京时间）
        </p>
      </div>
      <noscript>
        <p class="notice">
          启用 JavaScript 后可切换分类、搜索和收藏。当前展示
          Skills；所有项目均可通过直达链接阅读。
        </p>
      </noscript>
    </section>
  </main>
  <script
    define:vars={{
      radar: {
        lastUpdated: catalog.lastSuccessfulCollectionAt,
        weeklyAt: catalog.trending.weekly.fetchedAt,
        weeklyError: catalog.trending.weekly.error,
      },
    }}
  >
    window.__radar = radar;
  </script>
  <script>
    import "../lib/client";
  </script>
</Layout>
