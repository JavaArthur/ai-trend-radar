---
import Layout from '../../layouts/Layout.astro';
import raw from '../../../data/catalog.json';
import type {Catalog,Project} from '../../lib/types';
import {metrics} from '../../lib/metrics';
import {categoryName,formName} from '../../lib/taxonomy';
import {number,datetime,sparkline} from '../../lib/display';
export function getStaticPaths(){return (raw as Catalog).projects.filter(p=>p.classification.aiRelated).map(project=>({params:{slug:project.slug},props:{project}}));}
const {project:p}=Astro.props as {project:Project};const c=p.classification;const m=metrics(p);const base=import.meta.env.BASE_URL.replace(/\/$/,'');const points=sparkline(p.snapshots.slice(-30));
const weekly=(raw as Catalog).trending.weekly.entries.find(e=>e.fullName.toLowerCase()===p.fullName.toLowerCase());
---
<Layout title={`${p.fullName} · AI 热榜雷达`} description={c.summary||p.description}>
<main id="main" class="detail-wrap" data-name={p.fullName}>
<a class="back-link" href={`${base}/#explore`}>← 返回项目目录</a>
<div class="detail-head"><div><span class="detail-owner">{p.fullName.split('/')[0]} /</span><h1>{p.fullName.split('/')[1]}</h1><div class="card-tags">{c.categories.map(id=><a href={`${base}/?category=${id}&view=all#explore`}><span>{categoryName(id)}</span></a>)}{c.forms.map(id=><span class="shape-tag">{formName(id)}</span>)}</div></div><span class="detail-status">{p.archived?'已归档':p.unavailable?'仓库暂不可用':!m.active?'近期未维护':m.rising?'持续上升':m.hot?'近期热门':'趋势观察中'}</span></div>
<p class="detail-summary">{c.summary||p.description||'项目未提供简介。'}</p><p class="fine">{c.status==='rules'?'原始仓库简介 · 中文摘要待补充':c.status==='manual'?'中文简介经编辑校订':'AI 根据仓库资料整理'} · {c.tags.join(' / ')}</p>
<div class="detail-actions"><a class="button dark" href={p.url} target="_blank" rel="noopener noreferrer">查看 GitHub 仓库 ↗</a>{p.homepage&&/^https?:\/\//.test(p.homepage)&&<a class="button light" href={p.homepage} target="_blank" rel="noopener noreferrer">项目主页 ↗</a>}<button class="save-button" data-save={p.id} aria-label={`收藏 ${p.fullName}`} aria-pressed="false">☆</button></div>
<div class="detail-grid"><section class="detail-box"><h2>热度，来自实际观测</h2><dl><div><dt>总 Star</dt><dd>{number(p.stars)}</dd></div><div><dt>近 7 天净增</dt><dd>{m.delta===null?'观察中':`${m.delta>=0?'+':''}${number(m.delta)}`}</dd></div><div><dt>近 7 天增长率</dt><dd>{m.rate===null?'—':`${(m.rate*100).toFixed(1)}%`}</dd></div><div><dt>已记录快照</dt><dd>{p.snapshots.length}<span class="fine"> 天</span></dd></div></dl>
{points?<svg class="detail-chart" viewBox="0 0 240 60" preserveAspectRatio="none" role="img" aria-label="最近最多30个真实快照的 Star 走势"><polyline points={points}/></svg>:<div class="chart-empty">第一颗观测点已经记录。<br/>积累更多快照后，这里会显示真实趋势。</div>}
<p class="fine">{m.from?`实际区间：${datetime(m.from)} — ${datetime(m.to)}。${m.complete?'日快照完整。':'区间有缺测，不能判断持续上升。'}`:'尚无约 7 天前的观测数据，不计算或估算周净增。'}</p>
{weekly&&<p class="fine">GitHub 官方周榜排名 #{weekly.rank} · 官方本周增长 {weekly.starsInPeriod===null?'未提供':number(weekly.starsInPeriod)} Star。<br/>周榜抓取：{datetime((raw as Catalog).trending.weekly.fetchedAt)}；与本站净增统计口径不同。</p>}
<p class="fine"><a href={`${base}/about/`}>查看数据口径 ↗</a></p></section>
<section class="detail-box"><h2>项目档案</h2><div class="facts">{[['主要语言',p.language||'未标注'],['许可证',p.license==='NOASSERTION'?'未识别，请查阅仓库':p.license||'未提供'],['Fork',number(p.forks)],['最近推送',datetime(p.pushedAt)],['仓库创建',datetime(p.createdAt)],['本站发现',datetime(p.firstSeenAt)],['数据更新',datetime(p.fetchedAt)]].map(([label,value])=><div class="fact"><span>{label}</span><strong>{value}</strong></div>)}</div></section></div>
<section class="detail-box evidence"><h2>收录与分类依据</h2>{c.evidence.map(e=><p><strong>{({description:'仓库简介',topics:'GitHub Topics',readme:'README 依据',manual:'编辑校订'})[e.source]}：</strong>{e.text}</p>)}<p class="fine">发现来源：{p.sources.map(s=>s==='trending'?'GitHub Trending':s.startsWith('search:')?`分类检索 · ${categoryName(s.slice(7))}`:'持续跟踪').join(' / ')}</p></section>
</main>
<script>import '../../lib/client';</script>
</Layout>
